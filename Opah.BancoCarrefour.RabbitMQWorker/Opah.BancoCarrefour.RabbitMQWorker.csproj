<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Opah.BancoCarrefour.RabbitMQWorker</RootNamespace>
    <UserSecretsId>dotnet-Opah.BancoCarrefour.RabbitMQWorker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Polly.Core" Version="8.6.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Opah.BancoCarrefour.Domain\Opah.BancoCarrefour.Domain.csproj" />
    <ProjectReference Include="..\Opah.BancoCarrefour.SqlServer.Repository\Opah.BancoCarrefour.SqlServer.Repository.csproj" />
    <ProjectReference Include="..\Opah.BancoCarrefour.Messaging\Opah.BancoCarrefour.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
